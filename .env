### --- Базовые переменные (настройки ВУ) --- ###
TCP_HOST_IP=127.0.0.1
TCP_HOST_PORT=12345
UDP_PORT=54321
MAC_SOCKET_BUF_SIZE=2048
ETH_INTERFACE_NAME=eth0

### -------------- ПРОТОКОЛ ПБУ ------------- ###
###				[Общий заголовок]			  ###

# Версия протокола подключения с ПБУ
PBU_PROTO_MAJOR_VERSION=2
PBU_PROTO_MINOR_VERSION=2

# Идентификатор отправителя данных (ВУ)
PBU_PROTO_HEAD_ID_SENDER=0x524C4E

###	      [Переменные по телу сообщений]  	  ###

# Идентификатор производителя
PBU_PROTO_0X01_ID_MANUF=0x24

# Серийный номер изделия
PBU_PROTO_0X01_SERIAL_NUM=245CE7454

# Версия модификации изделия мажор
PBU_PROTO_0X01_VERS_HARD_MAJ=3

# Версия модификации изделия минор
PBU_PROTO_0X01_VERS_HARD_MIN=0

# Версия ПО нашего ВУ (мажор)
PBU_PROTO_0X01_VERS_PROG_MAJ=1

# Версия ПО нашего ВУ (минор)
PBU_PROTO_0X01_VERS_PROG_MIN=0

# Координата X/Широта (Геопозиция)
PBU_PROTO_0X05_X_LAT_GEO=0

# Координата X/Широта (Координаты в системе комплекса)
PBU_PROTO_0X05_X_LAT_COORD=0

# Координата Y/Долгота (Геопозиция)
PBU_PROTO_0X05_Y_LONG_GEO=0

# Координата Y/Долгота (Координаты в системе комплекса)
PBU_PROTO_0X05_Y_LONG_COORD=0

# Координата Z/Высота (Геопозиция)
PBU_PROTO_0X05_Z_HEIGHT_GEO=0

# Координата Z/Высота (Координаты в системе комплекса)
PBU_PROTO_0X05_Z_HEIGHT_COORD=0
